#BlueJ class context
comment0.target=MyDodo
comment0.text=\r\n\r\n\ @author\ Sjaak\ Smetsers\ &\ Renske\ Smetsers-Weeda\r\n\ @version\ 3.0\ --\ 20-01-2017\r\n
comment1.params=
comment1.target=MyDodo()
comment10.params=
comment10.target=void\ hatchEgg()
comment10.text=\r\n\ Hatches\ the\ egg\ in\ the\ current\ cell\ by\ removing\r\n\ the\ egg\ from\ the\ cell.\r\n\ Gives\ an\ error\ message\ if\ there\ is\ no\ egg\r\n\ \r\n\ <p>\ Initial\:\ Dodo\ is\ somewhere\ in\ the\ world.\ There\ is\ an\ egg\ in\ Dodo's\ cell.\r\n\ <p>\ Final\:\ Dodo\ is\ in\ the\ same\ cell.\ The\ egg\ has\ been\ removed\ (hatched).\ \ \ \ \ \r\n
comment11.params=
comment11.target=void\ gotoEgg()
comment11.text=\r\n\ The\ Dodo\ can\ walk\ to\ the\ egg.\r\n\ The\ Dodo\ stops\ if\ theres\ a\ border\ ahead.\r\n
comment12.params=
comment12.target=int\ getNrOfEggsHatched()
comment12.text=\r\n\ Returns\ the\ number\ of\ eggs\ Dodo\ has\ hatched\ so\ far.\r\n\ \r\n\ @return\ int\ number\ of\ eggs\ hatched\ by\ Dodo\r\n
comment13.params=distance
comment13.target=void\ jump(int)
comment13.text=\r\n\ Move\ given\ number\ of\ cells\ forward\ in\ the\ current\ direction.\r\n\ \r\n\ <p>\ Initial\:\ \ \ \r\n\ <p>\ Final\:\ \ \r\n\ \r\n\ @param\ \ \ int\ distance\:\ the\ number\ of\ steps\ made\r\n
comment14.params=
comment14.target=void\ walkToWorldEdge()
comment14.text=\r\n\ Walks\ to\ edge\ of\ the\ world\ printing\ the\ coordinates\ at\ each\ step\r\n\ \r\n\ <p>\ Initial\:\ Dodo\ is\ on\ West\ side\ of\ world\ facing\ East.\r\n\ <p>\ Final\:\ \ \ Dodo\ is\ on\ East\ side\ of\ world\ facing\ East.\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ Coordinates\ of\ each\ cell\ printed\ in\ the\ console.\r\n
comment15.params=
comment15.target=void\ goBackToStartOfRowAndFaceBack()
comment15.text=\r\n\ The\ Dodo\ turns\ around\ and\ walks\ to\ the\ edge\ of\ the\ world\ and\ then\ turns\ around.\r\n
comment16.params=
comment16.target=int\ countEggsInRow()
comment16.text=\r\n\ The\ Eggs\ are\ counted\ in\ a\ row,\ and\ the\ Dodo\ returns\ to\ the\ start.\r\n\ showCompliment\ prints\ how\ many\ eggs\ are\ counted.\r\n
comment17.params=
comment17.target=void\ countWorldEggs()
comment17.text=\r\n\ The\ Dodo\ can\ count\ all\ the\ eggs\ in\ the\ world\ grid.\ \r\n
comment18.params=
comment18.target=boolean\ canLayEgg()
comment18.text=\r\n\ Test\ if\ Dodo\ can\ lay\ an\ egg.\r\n\ \ \ \ \ \ \ \ \ \ (there\ is\ not\ already\ an\ egg\ in\ the\ cell)\r\n\ \r\n\ <p>\ Initial\:\ Dodo\ is\ somewhere\ in\ the\ world\r\n\ <p>\ Final\:\ \ \ Same\ as\ initial\ situation\r\n\ \r\n\ @return\ boolean\ true\ if\ Dodo\ can\ lay\ an\ egg\ (no\ egg\ there)\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ false\ if\ Dodo\ can't\ lay\ an\ egg\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ (already\ an\ egg\ in\ the\ cell)\r\n
comment19.params=
comment19.target=void\ turn180()
comment19.text=\r\n\ The\ Dodo\ turns\ around\ 180\ degrees.\r\n
comment2.params=
comment2.target=void\ act()
comment20.params=
comment20.target=void\ layEggOnEmptyNests()
comment20.text=\r\n\ This\ methode\ makes\ the\ Dodo\ lay\ egg\ on\ the\ nests\ all\ to\ the\ row.\r\n\ The\ last\ if\ is\ for\ the\ dodo\ to\ lay\ an\ egg\ on\ the\ nest\ on\ the\ last\ cell\ of\ the\ grid.\r\n
comment21.params=
comment21.target=void\ walkAroundFencedArea()
comment21.text=\r\n\ This\ methode\ makes\ the\ Dodo\ go\ around\ a\ fenced\ area\ to\ get\ to\ a\ egg.\r\n\ With\ the\ dodo\ stopping\ by\ the\ egg.\r\n
comment22.params=
comment22.target=void\ eggTrailToNest()
comment22.text=\r\n\ The\ Dodo\ can\ follow\ with\ this\ methode\ a\ trail\ of\ eggs\ to\ the\ nest.\r\n
comment23.params=
comment23.target=void\ goFindNestInMaze()
comment23.text=\r\n\ This\ Methode\ makes\ the\ Dodo\ go\ through\ the\ route\ of\ a\ maze\ to\ the\ nest.\r\n
comment24.params=
comment24.target=void\ changeEggValue()
comment24.text=\r\n\ This\ methode\ makes\ the\ eggs\ changes\ values\ were\ the\ temporary\ egg\r\n\ gets\ the\ value\ of\ the\ blue\ egg\ and\ the\ blue\ egg\ gets\ the\ value\r\n\ of\ the\ golden\ egg,\r\n\ while\ the\ golden\ egg\ gets\ the\ value\ of\ the\ temporary\ egg.\r\n
comment25.params=directions
comment25.target=void\ faceDirection(int)
comment25.text=\r\n\ This\ methode\ is\ for\ the\ Dodo\ that\ he\ can\ change\ direction\ of\ face.\r\n\ Para\ direction\ is\ what\ the\ Dodo\ would\ be\ facing.\r\n
comment26.params=coordX\ coordY
comment26.target=void\ goToLocation(int,\ int)
comment26.text=\r\n\ This\ methode\ can\ make\ the\ Dodo\ follow\ the\ cordinates\ in\ the\ grid.\r\n
comment27.params=x\ y
comment27.target=boolean\ validCoordinates(int,\ int)
comment27.text=\r\n\ This\ methode\ checks\ if\ the\ coordinates\ are\ within\ or\ outside\ the\ grid.\r\n\ It\ shows\ an\ error\ message\ if\ the\ coordinates\ is\ out\ of\ bounds.\r\n
comment28.params=n
comment28.target=void\ layTrailOfEggs(int)
comment28.text=\r\n\ The\ Dodo\ wil\ walk\ while\ laying\ eggs\ and\ stop\ by\ the\ last\ egg.\r\n
comment29.params=
comment29.target=int\ findRowWithMostEggs()
comment29.text=\r\n\ This\ methode\ is\ were\ the\ Dodo\ counts\ and\ print\ which\ row\ has\ the\ most\ eggs.\r\n\ If\ there\ are\ two\ rows\ with\ the\ same\ amount\ of\ eggs\ than\ wint\ the\ first\ one.\r\n
comment3.params=
comment3.target=void\ move()
comment3.text=\r\n\ Move\ one\ cell\ forward\ in\ the\ current\ direction.\r\n\ \r\n\ <P>\ Initial\:\ Dodo\ is\ somewhere\ in\ the\ world\r\n\ <P>\ Final\:\ If\ possible,\ Dodo\ has\ moved\ forward\ one\ cell\r\n\r\n
comment30.params=
comment30.target=void\ monumentOfEggs()
comment4.params=
comment4.target=boolean\ canMove()
comment4.text=\r\n\ Test\ if\ Dodo\ can\ move\ forward,\ (there\ are\ no\ obstructions\r\n\ \ \ \ or\ end\ of\ world\ in\ the\ cell\ in\ front\ of\ her).\r\n\ \r\n\ <p>\ Initial\:\ Dodo\ is\ somewhere\ in\ the\ world\r\n\ <p>\ Final\:\ \ \ Same\ as\ initial\ situation\r\n\ \r\n\ @return\ boolean\ true\ if\ Dodo\ can\ move\ (no\ obstructions\ ahead)\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ false\ if\ Dodo\ can't\ move\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ (an\ obstruction\ or\ end\ of\ world\ ahead)\r\n
comment5.params=
comment5.target=void\ climbOverFence()
comment5.text=\r\n\ The\ Dodo\ can\ move\ over\ the\ fence\ to\ climb\ around.\r\n
comment6.params=
comment6.target=void\ walkToWorldEdgeClimbingOverFences()
comment6.text=\r\n\ The\ Dodo\ lays\ egg\ in\ the\ nests\ on\ the\ way\r\n\ The\ Dodo\ walks\ to\ the\ front\ of\ a\ fence\r\n\ checks\ if\ there's\ a\ fence\ ahead.\r\n\ climbes\ over\ the\ fence.\r\n\ move\ and\ checks\ again.\r\n
comment7.params=
comment7.target=boolean\ grainAhead()
comment7.text=\r\n\ The\ Dodo\ grab\ the\ grain\ that\ is\ infront\ of\ where\ the\ Dodo\ is\ facing.\r\n\ This\ methode\ has\ a\ submethode\ stepOneCellBackwards()\ for\ the\ dodo\ to\ step\ back.\r\n
comment8.params=
comment8.target=void\ stepOneCellBackwards()
comment8.text=\r\n\ This\ methode\ is\ for\ the\ Dodo\ to\ go\ a\ step\ back.\r\n
comment9.params=
comment9.target=void\ pickUpGrainsAndPrintCoordinates()
comment9.text=\r\n\ This\ methode\ is\ were\ the\ Dodo\ moves\ to\ the\ edge\ of\ the\ world\r\n\ and\ prints\ the\ coordinates\ of\ the\ positions\ were\ the\ grains\ were.\r\n
