#BlueJ class context
comment0.target=MyDodo
comment0.text=\r\n\r\n\ @author\ Sjaak\ Smetsers\ &\ Renske\ Smetsers-Weeda\r\n\ @version\ 3.0\ --\ 20-01-2017\r\n
comment1.params=
comment1.target=MyDodo()
comment10.params=
comment10.target=void\ hatchEgg()
comment10.text=\r\n\ Hatches\ the\ egg\ in\ the\ current\ cell\ by\ removing\r\n\ the\ egg\ from\ the\ cell.\r\n\ Gives\ an\ error\ message\ if\ there\ is\ no\ egg\r\n\ \r\n\ <p>\ Initial\:\ Dodo\ is\ somewhere\ in\ the\ world.\ There\ is\ an\ egg\ in\ Dodo's\ cell.\r\n\ <p>\ Final\:\ Dodo\ is\ in\ the\ same\ cell.\ The\ egg\ has\ been\ removed\ (hatched).\ \ \ \ \ \r\n
comment11.params=
comment11.target=void\ gotoEgg()
comment11.text=\r\n\ The\ Dodo\ can\ walk\ to\ the\ egg.\r\n\ The\ Dodo\ stops\ if\ theres\ a\ border\ ahead.\r\n
comment12.params=
comment12.target=int\ getNrOfEggsHatched()
comment12.text=\r\n\ Returns\ the\ number\ of\ eggs\ Dodo\ has\ hatched\ so\ far.\r\n\ \r\n\ @return\ int\ number\ of\ eggs\ hatched\ by\ Dodo\r\n
comment13.params=distance
comment13.target=void\ jump(int)
comment13.text=\r\n\ Move\ given\ number\ of\ cells\ forward\ in\ the\ current\ direction.\r\n\ \r\n\ <p>\ Initial\:\ \ \ \r\n\ <p>\ Final\:\ \ \r\n\ \r\n\ @param\ \ \ int\ distance\:\ the\ number\ of\ steps\ made\r\n
comment14.params=
comment14.target=void\ walkToWorldEdge()
comment14.text=\r\n\ Walks\ to\ edge\ of\ the\ world\ printing\ the\ coordinates\ at\ each\ step\r\n\ \r\n\ <p>\ Initial\:\ Dodo\ is\ on\ West\ side\ of\ world\ facing\ East.\r\n\ <p>\ Final\:\ \ \ Dodo\ is\ on\ East\ side\ of\ world\ facing\ East.\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ Coordinates\ of\ each\ cell\ printed\ in\ the\ console.\r\n
comment15.params=
comment15.target=void\ goBackToStartOfRowAndFaceBack()
comment15.text=\r\n\ The\ Dodo\ turns\ around\ and\ walks\ to\ the\ edge\ of\ the\ world\ and\ then\ turns\ around.\r\n
comment16.params=
comment16.target=boolean\ canLayEgg()
comment16.text=\r\n\ Test\ if\ Dodo\ can\ lay\ an\ egg.\r\n\ \ \ \ \ \ \ \ \ \ (there\ is\ not\ already\ an\ egg\ in\ the\ cell)\r\n\ \r\n\ <p>\ Initial\:\ Dodo\ is\ somewhere\ in\ the\ world\r\n\ <p>\ Final\:\ \ \ Same\ as\ initial\ situation\r\n\ \r\n\ @return\ boolean\ true\ if\ Dodo\ can\ lay\ an\ egg\ (no\ egg\ there)\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ false\ if\ Dodo\ can't\ lay\ an\ egg\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ (already\ an\ egg\ in\ the\ cell)\r\n
comment17.params=
comment17.target=void\ turn180()
comment17.text=\r\n\ The\ Dodo\ turns\ around\ 180\ degrees.\r\n
comment18.params=
comment18.target=void\ layEggOnEmptyNests()
comment18.text=\r\n\ This\ methode\ makes\ the\ Dodo\ lay\ egg\ on\ the\ nests\ all\ to\ the\ row.\r\n\ The\ last\ if\ is\ for\ the\ dodo\ to\ lay\ an\ egg\ on\ the\ nest\ on\ the\ last\ cell\ of\ the\ grid.\r\n
comment19.params=
comment19.target=void\ walkAroundFencedArea()
comment19.text=\r\n\ This\ methode\ makes\ the\ Dodo\ go\ around\ a\ fenced\ area\ to\ get\ to\ a\ egg.\r\n\ With\ the\ dodo\ stopping\ by\ the\ egg.\r\n
comment2.params=
comment2.target=void\ act()
comment3.params=
comment3.target=void\ move()
comment3.text=\r\n\ Move\ one\ cell\ forward\ in\ the\ current\ direction.\r\n\ \r\n\ <P>\ Initial\:\ Dodo\ is\ somewhere\ in\ the\ world\r\n\ <P>\ Final\:\ If\ possible,\ Dodo\ has\ moved\ forward\ one\ cell\r\n\r\n
comment4.params=
comment4.target=boolean\ canMove()
comment4.text=\r\n\ Test\ if\ Dodo\ can\ move\ forward,\ (there\ are\ no\ obstructions\r\n\ \ \ \ or\ end\ of\ world\ in\ the\ cell\ in\ front\ of\ her).\r\n\ \r\n\ <p>\ Initial\:\ Dodo\ is\ somewhere\ in\ the\ world\r\n\ <p>\ Final\:\ \ \ Same\ as\ initial\ situation\r\n\ \r\n\ @return\ boolean\ true\ if\ Dodo\ can\ move\ (no\ obstructions\ ahead)\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ false\ if\ Dodo\ can't\ move\r\n\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ (an\ obstruction\ or\ end\ of\ world\ ahead)\r\n
comment5.params=
comment5.target=void\ climbOverFence()
comment5.text=\r\n\ The\ Dodo\ can\ move\ over\ the\ fence\ to\ climb\ around.\r\n
comment6.params=
comment6.target=void\ walkToWorldEdgeClimbingOverFences()
comment6.text=\r\n\ The\ Dodo\ lays\ egg\ in\ the\ nests\ on\ the\ way\r\n\ The\ Dodo\ walks\ to\ the\ front\ of\ a\ fence\r\n\ checks\ if\ there's\ a\ fence\ ahead.\r\n\ climbes\ over\ the\ fence.\r\n\ move\ and\ checks\ again.\r\n
comment7.params=
comment7.target=boolean\ grainAhead()
comment7.text=\r\n\ The\ Dodo\ grab\ the\ grain\ that\ is\ infront\ of\ where\ the\ Dodo\ is\ facing.\r\n\ This\ methode\ has\ a\ submethode\ stepOneCellBackwards()\ for\ the\ dodo\ to\ step\ back.\r\n
comment8.params=
comment8.target=void\ stepOneCellBackwards()
comment8.text=\r\n\ This\ methode\ is\ for\ the\ Dodo\ to\ go\ a\ step\ back.\r\n
comment9.params=
comment9.target=void\ pickUpGrainsAndPrintCoordinates()
comment9.text=\r\n\ This\ methode\ is\ were\ the\ Dodo\ moves\ to\ the\ edge\ of\ the\ world\r\n\ and\ prints\ the\ coordinates\ of\ the\ positions\ were\ the\ grains\ were.\r\n
